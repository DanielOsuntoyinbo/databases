// Rendered by Ansible from infrastructure/ansible/roles/replicaset/templates/rs_initiate.js.j2
// Member IDs, priorities and region tags come straight from the
// inventory generated by scripts/inventory/psmdb.py — this is the
// file slide 14 ("place replica-set members across the domains") and
// slide 21 ("priority") point at directly.
rs.initiate({
  _id: "{{ psmdb_replset_name }}",
  members: [
{% for host in groups['replicaset'] %}
    {
      _id: {{ hostvars[host].replicaset_member_id }},
      host: "{{ hostvars[host].private_ip }}:{{ psmdb_port }}",
      priority: {{ hostvars[host].replicaset_priority }},
      tags: { region: "{{ hostvars[host].region }}" }
    }{% if not loop.last %},{% endif %}

{% endfor %}
  ]
})
