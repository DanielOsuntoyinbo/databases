*.retry

# Ansible vault — keep the real encrypted/local vault out of the public repo.
# Commit only vault.yml.example.
infrastructure/ansible/inventory/group_vars/all/vault.yml
infrastructure/ansible/inventory/group_vars/all/vault.yml.dec

